{
  "pages": {
    "/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/layout.css",
      "static/chunks/app/layout.js"
    ],
    "/not-found": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/not-found.js"
    ],
    "/(public)/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(public)/layout.js"
    ],
    "/(public)/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/(public)/page.css",
      "static/chunks/app/(public)/page.js"
    ],
    "/(public)/blog/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/(public)/blog/page.css",
      "static/chunks/app/(public)/blog/page.js"
    ],
    "/(public)/blog/[slug]/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(public)/blog/[slug]/page.js"
    ],
    "/admin/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/admin/layout.js"
    ],
    "/admin/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/admin/page.js"
    ],
    "/admin/(dashboard)/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/admin/(dashboard)/layout.css",
      "static/chunks/app/admin/(dashboard)/layout.js"
    ],
    "/admin/(dashboard)/dashboard/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/admin/(dashboard)/dashboard/page.js"
    ],
    "/admin/login/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/admin/login/page.js"
    ],
    "/admin/(dashboard)/blog/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/admin/(dashboard)/blog/page.css",
      "static/chunks/app/admin/(dashboard)/blog/page.js"
    ]
  }
}